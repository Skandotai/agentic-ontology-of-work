{
  "@context": [
    "https://w3id.org/aow/context.jsonld",
    { "@base": "https://example.org/claims/" }
  ],
  "@graph": [
    {
      "id": "obj-claims-cycle-time",
      "type": "Objective",
      "label": "Faster disability claims",
      "description": "Reduce disability claims cycle time by 20% without increasing claims leakage.",
      "kpi_target": "Median cycle time -20% against the FY2026 baseline; leakage no higher than baseline.",
      "priority": "high",
      "time_horizon": "FY2027"
    },
    {
      "id": "intent-eligibility-2026",
      "type": "Intent",
      "label": "Automate eligibility determination",
      "goal_statement": "Determine eligibility for incoming disability claims automatically wherever policy allows, and route the rest to an adjuster with the work already done.",
      "serves_objective": "obj-claims-cycle-time",
      "shaped_by": ["ctx-claims-procedure"],
      "constrained_by": ["policy-auto-approval", "policy-high-risk-review"],
      "requires_assurance": "aow:AL2",
      "acceptable_risk_band": "low",
      "priority": "high",
      "status": "active"
    },
    {
      "id": "ctx-claims-procedure",
      "type": "Context",
      "label": "Disability claims procedure",
      "context_type": "procedural",
      "variables": { "procedure": "LTD eligibility v7", "regulatory_regime": "state insurance code", "service_level_hours": 48 },
      "sensitivity_level": "internal",
      "draws_on": ["kb-claims"]
    },
    {
      "id": "policy-auto-approval",
      "type": "Policy",
      "label": "Auto-approval limit",
      "rule_set": "An eligibility decision on a disability claim under $50,000 may be recorded without human confirmation when eligibility confidence is at least 0.90.",
      "rule_language": "text",
      "effect": "permit",
      "trigger_conditions": ["claim_amount < 50000", "confidence >= 0.90"],
      "severity": "high",
      "override_protocol": "Claims operations lead may lower the limit at any time; raising it requires model risk approval.",
      "escalates_to": ["role-claims-adjuster"]
    },
    {
      "id": "policy-high-risk-review",
      "type": "Policy",
      "label": "High-risk review",
      "rule_set": "Claims with fraud indicators, or from claimants over 65 with pre-existing conditions, require adjuster review before a decision is recorded.",
      "rule_language": "text",
      "effect": "escalate",
      "trigger_conditions": ["fraud_indicator = true", "claimant_age > 65 and pre_existing_condition = true"],
      "severity": "high",
      "escalates_to": ["role-claims-adjuster"],
      "version": "1.1.0",
      "revision_of": "policy-high-risk-review-v1.0"
    },
    {
      "id": "policy-high-risk-review-v1.0",
      "type": "Policy",
      "label": "High-risk review (superseded)",
      "rule_set": "Claims with fraud indicators require adjuster review before a decision is recorded.",
      "rule_language": "text",
      "effect": "escalate",
      "version": "1.0.0"
    },
    {
      "id": "role-eligibility-processor",
      "type": "Role",
      "label": "Eligibility processor",
      "responsibilities": ["Extract claim details", "Validate coverage", "Calculate benefit", "Record eligibility decisions within policy"]
    },
    {
      "id": "role-claims-adjuster",
      "type": "Role",
      "label": "Claims adjuster",
      "responsibilities": ["Decide escalated claims", "Confirm low-confidence decisions", "Give feedback on automated decisions"]
    },
    {
      "id": "orch-claims",
      "type": "Orchestrator",
      "name": "Claims orchestrator",
      "planning_model": "hybrid: rule-based task graph with model-assisted exception handling",
      "exception_protocol": "On any failed or blocked Task, stop the Plan and assign the decision Task to the Claims adjuster role."
    },
    {
      "id": "agent-validation",
      "type": "Agent",
      "name": "Validation agent",
      "fills_role": ["role-eligibility-processor"],
      "has_skill": ["skill-extract-claim-fields", "skill-rule-validate", "skill-record-decision"],
      "autonomy_level": "aow:AL3",
      "writes_to": ["mem-runtime-claims"],
      "version": "3.2.0"
    },
    {
      "id": "agent-coverage",
      "type": "Agent",
      "name": "Coverage agent",
      "fills_role": ["role-eligibility-processor"],
      "has_skill": ["skill-check-coverage"],
      "autonomy_level": "aow:AL3"
    },
    {
      "id": "agent-benefit",
      "type": "Agent",
      "name": "Benefit agent",
      "fills_role": ["role-eligibility-processor"],
      "has_skill": ["skill-calculate-benefit"],
      "autonomy_level": "aow:AL3"
    },
    {
      "id": "person-adjuster-17",
      "type": "HumanActor",
      "name": "Claims adjuster 17",
      "organizational_unit": "Disability Claims",
      "fills_role": ["role-claims-adjuster"],
      "has_skill": ["skill-record-decision"]
    },
    {
      "id": "guardian-claims",
      "type": "Guardian",
      "name": "Claims guardian",
      "enforcement_mode": "preventive",
      "scope": "All eligibility decisions on disability claims.",
      "enforces": ["policy-auto-approval", "policy-high-risk-review", "aow:AL2"],
      "oversees": ["agent-validation", "agent-coverage", "agent-benefit"],
      "escalates_to": ["role-claims-adjuster"]
    },
    {
      "id": "skill-extract-claim-fields",
      "type": "Skill",
      "label": "extract_claim_fields",
      "binding": "mcp://claims-tools/extract_claim_fields",
      "side_effects": "none",
      "input_schema": { "type": "object", "properties": { "document_uri": { "type": "string" } } },
      "output_schema": { "type": "object", "properties": { "claim_amount": { "type": "number" }, "claimant_age": { "type": "integer" } } },
      "latency": "< 5s",
      "cost_profile": "medium"
    },
    {
      "id": "skill-check-coverage",
      "type": "Skill",
      "label": "check_coverage",
      "binding": "https://api.example.org/policy-admin/coverage",
      "side_effects": "none",
      "latency": "< 1s",
      "cost_profile": "low"
    },
    {
      "id": "skill-rule-validate",
      "type": "Skill",
      "label": "rule_validate",
      "binding": "dmn://claims/eligibility-rules",
      "side_effects": "none",
      "cost_profile": "low"
    },
    {
      "id": "skill-calculate-benefit",
      "type": "Skill",
      "label": "calculate_benefit",
      "binding": "mcp://claims-tools/calculate_benefit",
      "side_effects": "none",
      "input_schema": { "type": "object", "properties": { "claim_amount": { "type": "number" }, "policy_rules": { "type": "object" } } },
      "output_schema": { "type": "object", "properties": { "benefit_amount": { "type": "number" } } },
      "latency": "< 1s",
      "cost_profile": "low",
      "version": "1.4.2",
      "created_by": "person-claims-engineering-lead"
    },
    {
      "id": "person-claims-engineering-lead",
      "type": "HumanActor",
      "name": "Claims engineering lead",
      "organizational_unit": "Claims Technology"
    },
    {
      "id": "skill-record-decision",
      "type": "Skill",
      "label": "record_decision",
      "binding": "https://api.example.org/claims/{claim}/decision",
      "side_effects": "reversible",
      "constrained_by": ["policy-auto-approval", "policy-high-risk-review"],
      "cost_profile": "low"
    },
    {
      "id": "kb-claims",
      "type": "KnowledgeBase",
      "label": "Claims knowledge base",
      "store_ref": "https://kb.example.org/claims",
      "retention_policy": "Case traces kept seven years for audit; patterns reviewed quarterly."
    },
    {
      "id": "mem-runtime-claims",
      "type": "OperationalMemory",
      "label": "Claims runtime memory",
      "retention_policy": "Purged 30 days after the claim closes."
    },

    {
