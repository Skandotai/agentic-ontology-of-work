        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "assigned to"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aow#Actor"
      }
    ],
    "https://w3id.org/aow#inverseLabel": [
      {
        "@language": "en",
        "@value": "assigned"
      }
    ],
    "https://w3id.org/aow#jsonKey": [
      {
        "@value": "assigned_to"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#autonomyLevel",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The highest Assurance Level the Agent has been cleared to operate at. The Agent may operate at a lower level on a given Task, never a higher one."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aow#Agent"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "autonomy level"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aow#AssuranceLevel"
      }
    ],
    "https://w3id.org/aow#jsonKey": [
      {
        "@value": "autonomy_level"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#binding",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "How to invoke it, for example an MCP tool name, an API endpoint, or a UI automation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aow#Skill"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "binding"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "https://w3id.org/aow#jsonKey": [
      {
        "@value": "binding"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#calibrated",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Whether the value has been calibrated against observed accuracy."
      }
