      {
        "@id": "https://w3id.org/aow#WorkItem"
      }
    ],
    "https://w3id.org/aow#inverseLabel": [
      {
        "@language": "en",
        "@value": "observed by"
      }
    ],
    "https://w3id.org/aow#jsonKey": [
      {
        "@value": "about"
      }
    ]
  },
