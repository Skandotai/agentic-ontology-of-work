    "@type": [
      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A correspondence to a term in a standard or protocol that has no dereferenceable IRI."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "alignment"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#approvedBy",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "People who confirmed the Action, Plan, or Result before it took effect. Required whenever the effective Assurance Level or a Policy calls for human confirmation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "approved by"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aow#HumanActor"
      }
    ],
    "https://schema.org/domainIncludes": [
      {
        "@id": "https://w3id.org/aow#Action"
      },
      {
        "@id": "https://w3id.org/aow#Plan"
      },
      {
        "@id": "https://w3id.org/aow#Result"
      }
    ],
    "https://w3id.org/aow#inverseLabel": [
      {
        "@language": "en",
        "@value": "approves"
      }
    ],
    "https://w3id.org/aow#jsonKey": [
      {
        "@value": "approved_by"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#artifacts",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Documents, records, or state changes the Result produced."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aow#Result"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "artifacts"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#anyURI"
      }
    ],
    "https://w3id.org/aow#jsonKey": [
