[
  {
    "@id": "https://w3id.org/aow",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/creator": [
      {
        "@value": "Manish Garg (Skan.ai)"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "A platform-agnostic semantic model for enterprise work performed by AI agents, people, and systems. AOW defines Objectives and the Intents and Plans derived from them; the Actors and Skills that perform the work; the Results and Outcomes produced; and the Assurance Levels, Feedback, and Memory used to govern and improve the work."
      }
    ],
    "http://purl.org/dc/terms/issued": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-09-24"
      }
    ],
    "http://purl.org/dc/terms/license": [
      {
        "@id": "https://www.apache.org/licenses/LICENSE-2.0"
      }
    ],
    "http://purl.org/dc/terms/publisher": [
      {
        "@value": "Skan, Inc."
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@language": "en",
        "@value": "Agentic Ontology of Work"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespacePrefix": [
      {
        "@value": "aow"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespaceUri": [
      {
        "@value": "https://w3id.org/aow#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://github.com/Skandotai/agentic-ontology-of-work"
      },
      {
        "@id": "https://skandotai.github.io/agentic-ontology-of-work/"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionIRI": [
      {
        "@id": "https://w3id.org/aow/2.0.0"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "2.0.0"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#AL0",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://w3id.org/aow#AssuranceLevel"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "AL0 Manual"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "AL0"
      }
    ],
    "https://w3id.org/aow#agentRole": [
      {
        "@language": "en",
        "@value": "Observes and prepares; takes no Action that changes a Work Item."
      }
    ],
    "https://w3id.org/aow#humanRole": [
      {
        "@language": "en",
        "@value": "Performs the work."
      }
    ],
    "https://w3id.org/aow#level": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 0
      }
    ],
    "https://w3id.org/aow#reviewProtocol": [
      {
        "@language": "en",
        "@value": "Not applicable; the work is done by people."
      }
    ],
    "https://w3id.org/aow#riskClass": [
      {
        "@language": "en",
        "@value": "Any risk; the default for work not yet assessed."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#AL1",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://w3id.org/aow#AssuranceLevel"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "AL1 Assisted"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "AL1"
      }
    ],
    "https://w3id.org/aow#agentRole": [
      {
        "@language": "en",
        "@value": "Recommends, drafts, and prepares."
      }
    ],
    "https://w3id.org/aow#humanRole": [
      {
        "@language": "en",
        "@value": "Decides. Approves every Action that changes a Work Item before it takes effect."
      }
    ],
    "https://w3id.org/aow#level": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "https://w3id.org/aow#reviewProtocol": [
      {
        "@language": "en",
        "@value": "Every state-changing Action carries approved_by."
      }
    ],
    "https://w3id.org/aow#riskClass": [
      {
        "@language": "en",
        "@value": "High-risk or irreversible decisions; new or poorly characterized work."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#AL2",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://w3id.org/aow#AssuranceLevel"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "AL2 Delegated"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "AL2"
      }
    ],
    "https://w3id.org/aow#agentRole": [
      {
        "@language": "en",
        "@value": "Decides and acts within Policy."
      }
    ],
    "https://w3id.org/aow#defaultConfidenceFloor": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#double",
        "@value": 0.9
      }
    ],
    "https://w3id.org/aow#humanRole": [
      {
        "@language": "en",
        "@value": "Confirms when confidence is low or a Policy triggers; reviews a sample otherwise."
      }
    ],
    "https://w3id.org/aow#level": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 2
      }
    ],
    "https://w3id.org/aow#reviewProtocol": [
      {
        "@language": "en",
        "@value": "Escalate below the confidence threshold or on Policy trigger; sampled review otherwise."
      }
    ],
    "https://w3id.org/aow#riskClass": [
      {
        "@language": "en",
        "@value": "Moderate-risk, well-characterized decisions."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#AL3",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://w3id.org/aow#AssuranceLevel"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "AL3 Supervised"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "AL3"
      }
    ],
    "https://w3id.org/aow#agentRole": [
      {
        "@language": "en",
        "@value": "Acts, and must be able to reverse or compensate its Actions."
      }
    ],
    "https://w3id.org/aow#defaultConfidenceFloor": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#double",
        "@value": 0.95
      }
    ],
    "https://w3id.org/aow#humanRole": [
      {
        "@language": "en",
        "@value": "Reviews by exception, when the Guardian raises an alert, and in periodic audit."
      }
    ],
    "https://w3id.org/aow#level": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 3
      }
    ],
    "https://w3id.org/aow#reviewProtocol": [
      {
        "@language": "en",
        "@value": "Guardian-raised exceptions and periodic audit; Skills used must be reversible."
      }
    ],
    "https://w3id.org/aow#riskClass": [
      {
        "@language": "en",
        "@value": "Low-to-moderate risk, reversible effects."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#AL4",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://w3id.org/aow#AssuranceLevel"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "AL4 Autonomous"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "AL4"
      }
    ],
    "https://w3id.org/aow#agentRole": [
      {
        "@language": "en",
        "@value": "Acts without routine human review; the Guardian can suspend it at any time."
      }
    ],
    "https://w3id.org/aow#defaultConfidenceFloor": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#double",
        "@value": 0.98
      }
    ],
    "https://w3id.org/aow#humanRole": [
      {
        "@language": "en",
        "@value": "Sets Policy and monitors aggregate Outcomes."
      }
    ],
    "https://w3id.org/aow#level": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 4
      }
    ],
    "https://w3id.org/aow#reviewProtocol": [
      {
        "@language": "en",
        "@value": "Continuous Guardian monitoring; audit of aggregate Outcomes."
      }
    ],
    "https://w3id.org/aow#riskClass": [
      {
        "@language": "en",
        "@value": "Low-risk, reversible, high-volume, well-characterized work."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#Action",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Records who did what, when, and why. Every Result is linked to the Action that produced it."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Action"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/prov#Activity"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#closeMatch": [
      {
        "@id": "https://schema.org/Action"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A single execution event in which an Actor invokes a Skill, in service of a Task, at a point in time."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Named but not defined in version 1.0. In 2.0, the Action produces the Result. A Skill is a capability. An Action is one use of it."
      }
    ],
    "https://w3id.org/aow#alignment": [
      {
        "@language": "en",
        "@value": "OpenTelemetry GenAI: execute_tool span (relatedMatch)"
      },
      {
        "@language": "en",
        "@value": "SOA-to-Agentic mapping: Idempotent Action (relatedMatch)"
      }
    ],
    "https://w3id.org/aow#layer": [
      {
        "@id": "https://w3id.org/aow#ExecutionLayer"
      }
    ],
    "https://w3id.org/aow#since": [
      {
        "@value": "1.0.0"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#Actor",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Allows work to be described the same way whether a person or an agent performs it."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Actor"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/prov#Agent"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Anything that can be assigned Tasks, perform Actions, and be held to account for them: an Agent, a person, an Orchestrator, or a Guardian."
      }
    ],
    "https://w3id.org/aow#layer": [
      {
        "@id": "https://w3id.org/aow#ExecutionLayer"
      }
    ],
    "https://w3id.org/aow#since": [
      {
        "@value": "2.0.0"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#Agent",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Describes an agent by its permitted capabilities and autonomy, not by its implementation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Agent"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/aow#Actor"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointWith": [
      {
        "@id": "https://w3id.org/aow#HumanActor"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A software Actor that interprets Intents and Tasks and acts on them using Skills, within the autonomy it has been cleared for."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "AOW does not describe models, prompts, or frameworks. implementation_ref may reference them."
      }
    ],
    "https://w3id.org/aow#alignment": [
      {
        "@language": "en",
        "@value": "Agent2Agent (A2A): Agent (AgentCard) (closeMatch)"
      },
      {
        "@language": "en",
        "@value": "OpenTelemetry GenAI: gen_ai.agent.* (relatedMatch)"
      },
      {
        "@language": "en",
        "@value": "SOA-to-Agentic mapping: Agent (from Service) (exactMatch)"
      }
    ],
    "https://w3id.org/aow#layer": [
      {
        "@id": "https://w3id.org/aow#ExecutionLayer"
      }
    ],
    "https://w3id.org/aow#since": [
      {
        "@value": "1.0.0"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#AssuranceLayer",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Governs autonomy, measures outcomes, and records feedback."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Sets permitted autonomy, measures confidence, oversees behavior, evaluates Outcomes, and records Feedback in Memory."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "4"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Assurance layer"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#AssuranceLevel",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Specifies the permitted autonomy and required human oversight for a piece of work. AOW defines five levels, AL0 to AL4."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Assurance Level"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A governance-set level of permitted autonomy, with the human oversight and evidence it requires."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Higher levels permit more autonomy and require more evidence before they are granted."
      }
    ],
    "https://w3id.org/aow#layer": [
      {
        "@id": "https://w3id.org/aow#AssuranceLayer"
      }
    ],
    "https://w3id.org/aow#since": [
      {
        "@value": "1.0.0"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#CognitionLayer",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Defines what should happen and the limits that apply."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Derives Intents from business Objectives, adds Context, applies Policy, and plans the work."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "2"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Cognition layer"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#Confidence",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Allows autonomy to depend on certainty. An Agent acts without approval only when its Confidence meets the threshold for its Assurance Level."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Confidence"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointWith": [
      {
        "@id": "https://w3id.org/aow#AssuranceLevel"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A model-, rule-, or human-derived measure of certainty about an Observation, a Result, or an Action."
      }
    ],
    "https://w3id.org/aow#layer": [
      {
        "@id": "https://w3id.org/aow#AssuranceLayer"
      }
    ],
    "https://w3id.org/aow#since": [
      {
        "@value": "1.0.0"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#Context",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Allows the same Intent to be handled differently in different situations, and records the information available to an Actor when it acted."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Context"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The structured situational information that gives relevance to an Intent."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Context types: environmental, procedural, data, historical, session."
      }
    ],
    "https://w3id.org/aow#alignment": [
      {
        "@language": "en",
        "@value": "BDI agent model: belief (relatedMatch)"
      },
      {
        "@language": "en",
        "@value": "Model Context Protocol: resource (relatedMatch)"
      }
    ],
    "https://w3id.org/aow#layer": [
      {
        "@id": "https://w3id.org/aow#CognitionLayer"
      }
    ],
    "https://w3id.org/aow#since": [
      {
        "@value": "1.0.0"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#ExecutionLayer",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Records who performed the work and what it changed."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Actors, both Agents and people, are assigned Tasks, invoke Skills through Actions, and produce Results."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "3"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Execution layer"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#Feedback",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Records changes proposed as a result of Outcomes, reviews, and incidents, and who proposed them."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Feedback"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Structured information, from people or systems, used to improve future behavior."
      }
    ],
    "https://w3id.org/aow#layer": [
      {
        "@id": "https://w3id.org/aow#AssuranceLayer"
      }
    ],
    "https://w3id.org/aow#since": [
      {
        "@value": "1.0.0"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#Guardian",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Separates performing work from checking it."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Guardian"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/aow#Actor"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The oversight Actor that enforces Policy and Assurance Levels, monitors behavior, and escalates to people when needed."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "A Guardian may be software, a person, or both. Its interventions are recorded as Actions."
      }
    ],
    "https://w3id.org/aow#layer": [
      {
        "@id": "https://w3id.org/aow#AssuranceLayer"
      }
    ],
    "https://w3id.org/aow#since": [
      {
        "@value": "1.0.0"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#HumanActor",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Records human participation, including approvals and decisions, in the same form as agent activity."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Human Actor"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/prov#Person"
      },
      {
        "@id": "https://w3id.org/aow#Actor"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A person who performs, approves, reviews, or oversees work."
      }
    ],
    "https://w3id.org/aow#layer": [
      {
        "@id": "https://w3id.org/aow#ExecutionLayer"
      }
    ],
    "https://w3id.org/aow#since": [
      {
        "@value": "2.0.0"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#Intent",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "States a business goal in a form that can be planned, assigned, governed, and verified."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Intent"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A structured, actionable goal derived from an Objective and interpretable by agents, orchestrators, and people."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Objective answers why. Intent answers what. Plan answers how."
      }
    ],
    "https://w3id.org/aow#alignment": [
      {
        "@language": "en",
        "@value": "BDI agent model: intention (relatedMatch)"
      }
    ],
    "https://w3id.org/aow#layer": [
      {
        "@id": "https://w3id.org/aow#CognitionLayer"
      }
    ],
    "https://w3id.org/aow#since": [
      {
        "@value": "1.0.0"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#KnowledgeBase",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Carries what was learned from one piece of work into the next."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Knowledge Base"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/aow#Memory"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Long-lived memory of generalized patterns, rules, and precedents."
      }
    ],
    "https://w3id.org/aow#layer": [
      {
        "@id": "https://w3id.org/aow#AssuranceLayer"
      }
    ],
    "https://w3id.org/aow#since": [
      {
        "@value": "1.0.0"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#Memory",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Retains information from past work for use in future Context and audit."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Memory"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Persistent knowledge accumulated from experience, used to inform future Context."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Two kinds: Operational Memory (short-lived) and Knowledge Base (long-lived)."
      }
    ],
    "https://w3id.org/aow#layer": [
      {
        "@id": "https://w3id.org/aow#AssuranceLayer"
      }
    ],
    "https://w3id.org/aow#since": [
      {
        "@value": "1.0.0"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#Objective",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Connects agentic activity to specific, measurable enterprise value."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Objective"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointWith": [
      {
        "@id": "https://w3id.org/aow#Intent"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A business-level goal expressed in strategic or operational terms."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Objective answers why. Intent answers what."
      }
    ],
    "https://w3id.org/aow#alignment": [
      {
        "@language": "en",
        "@value": "BDI agent model: desire (relatedMatch)"
      }
    ],
    "https://w3id.org/aow#layer": [
      {
        "@id": "https://w3id.org/aow#CognitionLayer"
      }
    ],
    "https://w3id.org/aow#since": [
      {
        "@value": "1.0.0"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#Observation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Separates recorded evidence (Signal) from its interpretation (Observation), so an incorrect interpretation can be identified and corrected."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/prov#Entity"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#closeMatch": [
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "An interpreted fact about a Work Item, Actor, or Action, derived from one or more Signals and carrying a Confidence."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "\"The claim amount is $38,200\" is an Observation; the scanned claim form it was extracted from is a Signal."
      }
    ],
    "https://w3id.org/aow#layer": [
      {
        "@id": "https://w3id.org/aow#PerceptionLayer"
      }
    ],
    "https://w3id.org/aow#since": [
      {
        "@value": "2.0.0"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#OperationalMemory",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Carries state across the steps of a single piece of work."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Operational Memory"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/aow#Memory"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointWith": [
      {
        "@id": "https://w3id.org/aow#KnowledgeBase"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Short-lived, execution-oriented memory scoped to a session, Task, or Work Item."
      }
    ],
    "https://w3id.org/aow#layer": [
      {
        "@id": "https://w3id.org/aow#AssuranceLayer"
      }
    ],
    "https://w3id.org/aow#since": [
      {
        "@value": "1.0.0"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#Orchestrator",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Decomposes Intents into Tasks and coordinates their execution."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Orchestrator"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/aow#Actor"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A coordinating Actor that turns Intents into Plans, assigns Tasks to Actors, and manages sequencing and exceptions."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "An Orchestrator may be an Agent, a workflow engine, or a person."
      }
    ],
    "https://w3id.org/aow#alignment": [
      {
        "@language": "en",
        "@value": "SOA-to-Agentic mapping: Agentic Orchestrator (exactMatch)"
      }
    ],
    "https://w3id.org/aow#layer": [
      {
        "@id": "https://w3id.org/aow#ExecutionLayer"
      }
    ],
    "https://w3id.org/aow#since": [
      {
        "@value": "1.0.0"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#Outcome",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Measures the effect of work against the Objective it served."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Outcome"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The aggregated business impact of one or more Results, measured against an Objective."
      }
    ],
    "https://w3id.org/aow#layer": [
      {
        "@id": "https://w3id.org/aow#AssuranceLayer"
      }
    ],
    "https://w3id.org/aow#since": [
      {
        "@value": "1.0.0"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#PerceptionLayer",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Records the work in progress and what is observed about it."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Records the Work Items in progress and the Signals and Observations about them. The other layers use this information."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "1"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Perception layer"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#Plan",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Separates planning from execution, so plans can be reviewed, approved, and compared."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Plan"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/prov#Plan"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "An ordered or partially ordered set of Tasks intended to fulfill an Intent, produced by an Orchestrator or other Actor."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Listed as an optional concept in version 1.0; a full entity in 2.0."
      },
      {
        "@language": "en",
        "@value": "The Orchestrator's dependency_graph in version 1.0 is the Plan's set of Tasks and their depends_on links."
      }
    ],
    "https://w3id.org/aow#layer": [
      {
        "@id": "https://w3id.org/aow#CognitionLayer"
      }
    ],
    "https://w3id.org/aow#since": [
      {
        "@value": "2.0.0"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#Policy",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "States governance rules in a form that can be checked by software. Policies constrain behavior. They do not perform Actions."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Policy"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#closeMatch": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/Policy"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Declarative constraints defining permissible, required, or restricted behavior."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "AOW does not prescribe a policy language. rule_set may hold rules in ODRL, Rego, Cedar, DMN, or plain text, named in rule_language."
      }
    ],
    "https://w3id.org/aow#alignment": [
      {
        "@language": "en",
        "@value": "OMG DMN: Decision (relatedMatch)"
      }
    ],
    "https://w3id.org/aow#layer": [
      {
        "@id": "https://w3id.org/aow#CognitionLayer"
      }
    ],
    "https://w3id.org/aow#since": [
      {
        "@value": "1.0.0"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#Result",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Records what an Action changed or produced, so it can be verified and aggregated into Outcomes."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Result"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/prov#Entity"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointWith": [
      {
        "@id": "https://w3id.org/aow#Outcome"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The immediate, atomic effect or output of an Action."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "A Result is local and immediate. An Outcome is aggregated and business-level."
      }
    ],
    "https://w3id.org/aow#layer": [
      {
        "@id": "https://w3id.org/aow#ExecutionLayer"
      }
    ],
    "https://w3id.org/aow#since": [
      {
        "@value": "1.0.0"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#Role",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Allows Tasks, Policies, and escalations to target a responsibility instead of a specific person or agent."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Role"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#closeMatch": [
      {
        "@id": "http://www.w3.org/ns/org#Role"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A named set of responsibilities and authority that an Actor can fill, such as \"claims adjuster\" or \"eligibility reviewer\"."
      }
    ],
    "https://w3id.org/aow#layer": [
      {
        "@id": "https://w3id.org/aow#ExecutionLayer"
      }
    ],
    "https://w3id.org/aow#since": [
      {
        "@value": "2.0.0"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#Signal",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Records what happened before any interpretation. Observations, Context, and audit trails are derived from Signals."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Signal"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/prov#Entity"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointWith": [
      {
        "@id": "https://w3id.org/aow#Observation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A raw, time-stamped trace emitted by a system, a person, or the environment: an event, a log line, a user-interface interaction, a document arriving, a state change, a metric sample."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "A Signal can be linked to the Action that generated it (generated_by). Agent activity can then be analyzed with the same tools used for human and system activity."
      },
      {
        "@language": "en",
        "@value": "Version 1.0 listed Telemetry Events, Signals, Session State, and Environmental Observations as Perception-layer elements without defining them. In 2.0 a Telemetry Event is a Signal whose signal_type is \"event\" or \"metric\"; Session State is Context with context_type \"session\"."
      }
    ],
    "https://w3id.org/aow#alignment": [
      {
        "@language": "en",
        "@value": "IEEE 1849 XES: event (closeMatch)"
      },
      {
        "@language": "en",
        "@value": "OpenTelemetry: span / log record / metric data point (relatedMatch)"
      }
    ],
    "https://w3id.org/aow#layer": [
      {
        "@id": "https://w3id.org/aow#PerceptionLayer"
      }
    ],
    "https://w3id.org/aow#since": [
      {
        "@value": "2.0.0"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#Skill",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Describes a capability's inputs, outputs, cost, and side effects, so it can be discovered, governed, and replaced."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Skill"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointWith": [
      {
        "@id": "https://w3id.org/aow#Action"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A reusable capability that an Actor can invoke."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "side_effects is new in 2.0. It records whether a Skill changes external state and whether the change can be reversed. Assurance Levels AL3 and AL4 do not permit irreversible Skills without approval."
      }
    ],
    "https://w3id.org/aow#alignment": [
      {
        "@language": "en",
        "@value": "Agent2Agent (A2A): AgentSkill (closeMatch)"
      },
      {
        "@language": "en",
        "@value": "Model Context Protocol: tool (closeMatch)"
      },
      {
        "@language": "en",
        "@value": "SOA-to-Agentic mapping: Agentic Tools (from Operation / Common Services) (relatedMatch)"
      }
    ],
    "https://w3id.org/aow#layer": [
      {
        "@id": "https://w3id.org/aow#ExecutionLayer"
      }
    ],
    "https://w3id.org/aow#since": [
      {
        "@value": "1.0.0"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#Task",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Defines the unit of work that is assigned. A Task is assigned to an Actor. An Action is performed to complete it. A Skill is the capability the Action uses."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Task"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointWith": [
      {
        "@id": "https://w3id.org/aow#Action"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A unit of assigned work within a Plan, performed by an Actor filling a Role."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Task states match the task states of the Agent2Agent (A2A) protocol, so Tasks can be exchanged over A2A without conversion."
      }
    ],
    "https://w3id.org/aow#alignment": [
      {
        "@language": "en",
        "@value": "Agent2Agent (A2A): Task (closeMatch)"
      },
      {
        "@language": "en",
        "@value": "BPMN 2.0: Task (relatedMatch)"
      }
    ],
    "https://w3id.org/aow#layer": [
      {
        "@id": "https://w3id.org/aow#ExecutionLayer"
      }
    ],
    "https://w3id.org/aow#since": [
      {
        "@value": "2.0.0"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#WorkItem",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Identifies the item that Intents, Tasks, Actions, and Observations refer to, so work on one item can be followed across systems, agents, and people."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/aow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Work Item"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The unit of business work that the rest of the ontology is about: a claim, an application, an order, a case, a ticket."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Corresponds to a case or object in process mining (IEEE 1849 XES and the OCEL 2.0 object-centric event log format)."
      },
      {
        "@language": "en",
        "@value": "In version 1.0 the work item was implicit in Context (for example, \"ctx-claim-84933\"). As a separate entity, it can be referenced by several Intents and Tasks."
      }
    ],
    "https://w3id.org/aow#alignment": [
      {
        "@language": "en",
        "@value": "BPMN 2.0: Data Object (relatedMatch)"
      },
      {
        "@language": "en",
        "@value": "IEEE 1849 XES: trace (case) (relatedMatch)"
      },
      {
        "@language": "en",
        "@value": "OCEL 2.0: object (closeMatch)"
      }
    ],
    "https://w3id.org/aow#layer": [
      {
        "@id": "https://w3id.org/aow#PerceptionLayer"
      }
    ],
    "https://w3id.org/aow#since": [
      {
        "@value": "2.0.0"
      }
    ]
  },
  {
    "@id": "https://w3id.org/aow#about",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "What the Observation describes."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
