{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/aow/schemas/feedback.schema.json",
  "title": "Feedback",
  "description": "Structured information, from people or systems, used to improve future behavior.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/ref",
      "description": "Stable identifier of the entity. Serialized as the node's IRI."
    },
    "type": {
      "const": "Feedback",
      "description": "The AOW class of the entity (for example, \"Intent\")."
    },
    "label": {
      "description": "Short human-readable name.",
      "type": "string"
    },
    "description": {
      "description": "Longer human-readable explanation.",
      "type": "string"
    },
    "version": {
      "description": "Version of this entity definition, ideally a semantic version such as \"1.4.2\".",
      "type": "string"
    },
    "created_at": {
      "description": "When this entity or version was created.",
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "description": "The Actor responsible for creating this entity or version.",
      "$ref": "#/$defs/ref"
    },
    "revision_of": {
      "description": "The earlier version this entity revises.",
      "$ref": "#/$defs/ref"
    },
    "feedback_type": {
      "description": "What the Feedback is about.",
      "enum": [
        "accuracy",
        "policy",
        "exception",
        "preference",
        "incident"
      ]
    },
    "issue_detected": {
      "description": "What went wrong or could be better.",
      "type": "string"
    },
    "recommended_adjustments": {
      "description": "Specific changes proposed.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "severity": {
      "description": "How urgent the Feedback is.",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "timestamp": {
      "description": "When the Feedback was given.",
      "type": "string",
      "format": "date-time"
    },
    "feedback_on": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      },
      "description": "What the Feedback is about."
    },
    "provided_by": {
      "$ref": "#/$defs/ref",
      "description": "Who gave the Feedback."
    },
    "updates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      },
      "description": "What the Feedback changed."
    }
  },
  "patternProperties": {
    "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_-]+$": {
      "description": "Extension property, namespaced with a prefix."
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "feedback_on"
  ],
  "$defs": {
    "ref": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier of an entity: an IRI, a compact IRI such as aow:AL2, or an id relative to the document base."
    }
  }
}
